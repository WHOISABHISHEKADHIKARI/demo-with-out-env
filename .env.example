# ======================================================================
#  Himalayan Vista Hotel — .env template
#  Copy this file to .env and fill in the values. NEVER commit .env.
#  All entries below exist (empty) to match the app's keyring.
# ======================================================================

NODE_ENV=production
PORT=8080

# hotel
HOTEL_ID=HVH-7788
HOTEL_NAME="Himalayan Vista Hotel"
HOTEL_REGION=ap-south-1

# api / auth
API_KEY=
API_SECRET=
BASE_URL=https://api.himalayanvista.example/v2
LEGACY_BASE_URL=https://api.example.com/v1/hotel
ADMIN_TOKEN=
JWT_SECRET=
LEGACY_TOKEN=
CMS_TOKEN=

# service tokens
PAYMENT_SIGNING_KEY=
INTERNAL_SVC_TOKEN=
AVAILABILITY_TOKEN=
HEALTH_TOKEN=
PELICAN_TOKEN=

# database
MONGO_URI=
STAGING_MONGO_URI=

# redis
REDIS_URL=redis://localhost:6379/2
REDIS_PASSWORD=

# payments
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
KHALTI_SECRET_KEY=
KHALTI_WEBHOOK_TOKEN=

# google / third-party
GOOGLE_MAPS_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
FIREBASE_API_KEY=
OAUTH_CLIENT_ID=
OPENWEATHER_KEY=

# email / messaging
MAILGUN_API_KEY=
SENDGRID_API_KEY=
TWILIO_SID=
TWILIO_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# analytics
ANALYTICS_ID=
MIXPANEL_TOKEN=
HOTJAR_SITE_ID=

# aws
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_MEDIA_BUCKET=hvh-media-prod
CLOUDFRONT_DISTRIBUTION_ID=
CLOUDFRONT_KEYPAIR_ID=